import type { LanguageSlice } from '@/types/content'

const SERIES = ['var(--series-1)', 'var(--series-2)', 'var(--series-3)', 'var(--series-4)']

/**
 * Stacked proportion meter.
 *
 * Colours are the validated categorical slots in fixed order — never cycled. Past
 * four slices, fold the remainder into "Other" in content/telemetry.ts rather than
 * generating a fifth hue. Every slice is direct-labelled, so identity is never
 * carried by colour alone, and 2px surface gaps separate adjacent fills.
 */
export function LanguageMeter({ slices }: { slices: LanguageSlice[] }) {
  const shown = slices.slice(0, SERIES.length)
  const total = shown.reduce((sum, s) => sum + s.percent, 0) || 1

  return (
    <div>
      <div
        className="flex h-1.5 w-full gap-0.5 overflow-hidden"
        role="img"
        aria-label={shown.map((s) => `${s.name} ${s.percent}%`).join(', ')}
      >
        {shown.map((slice, i) => (
          <span
            key={slice.name}
            className="h-full rounded-[2px]"
            style={{
              width: `${(slice.percent / total) * 100}%`,
              background: SERIES[i],
            }}
          />
        ))}
      </div>

      <ul className="mt-2.5 flex flex-wrap gap-x-3 gap-y-1">
        {shown.map((slice, i) => (
          <li key={slice.name} className="flex items-center gap-1.5 text-[10.5px]">
            <span
              aria-hidden
              className="size-2 shrink-0 rounded-[2px]"
              style={{ background: SERIES[i] }}
            />
            <span className="text-[var(--text-secondary)]">{slice.name}</span>
            <span className="tabular-nums text-[var(--text-muted)]">{slice.percent}%</span>
          </li>
        ))}
      </ul>
    </div>
  )
}
